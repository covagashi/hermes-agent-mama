<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- usesCleartextTraffic: el FakeGateway in-process sirve ws://127.0.0.1 en
         los tests instrumentados (C4/C7, igual que F2 con MockWebServer). -->
    <application android:usesCleartextTraffic="true">
        <!-- Host de createAndroidComposeRule<ComponentActivity>; sin declararla
             el intent MAIN/LAUNCHER no resuelve y el proceso de test muere. -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="true" />
        <!-- Host mínimo para las pruebas Compose de Chats (C3). -->
        <activity
            android:name="ai.hermes.mama.feature.chat.chats.ChatsTestActivity"
            android:exported="false" />
        <!-- Demo de la pantalla Chats con FakeGateway en proceso (capturas de
             emulador §7.1): `adb shell am start -n <pkg>.test/.chats.ChatsDemoActivity`. -->
        <activity
            android:name="ai.hermes.mama.feature.chat.chats.ChatsDemoActivity"
            android:exported="true" />
    </application>
</manifest>
