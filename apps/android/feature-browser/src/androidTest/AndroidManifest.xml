<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- G1: la notificación de descarga se ejercita de verdad en los tests. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- usesCleartextTraffic: MockWebServer sirve http://localhost en los tests (F2). -->
    <application android:usesCleartextTraffic="true">
        <!-- Activity mínima que hospeda el WebView bajo test (F1). -->
        <activity
            android:name="ai.hermes.mama.feature.browser.SnapshotTestActivity"
            android:exported="false" />
        <!-- Activity que hospeda el WebViewDriver del controlador (F2). -->
        <activity
            android:name="ai.hermes.mama.feature.browser.ControllerTestActivity"
            android:exported="false" />
        <!-- Host de createAndroidComposeRule<ComponentActivity> en el test E2E
             de F4; sin declararla el intent MAIN/LAUNCHER no resuelve y el
             proceso de test muere. -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="true" />
    </application>
</manifest>
